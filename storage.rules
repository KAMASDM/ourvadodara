rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // ===== POSTS =====
    match /posts/{userId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 100 * 1024 * 1024
                   && request.resource.contentType.matches('(image|video)/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    match /posts/images/{fileName} {
      allow read: if true;
      allow write: if false;
    }
    
    match /posts/videos/{fileName} {
      allow read: if true;
      allow write: if false;
    }
    
    match /posts/files/{fileName} {
      allow read: if true;
      allow write: if false;
    }
    
    // ===== STORIES =====
    match /stories/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 50 * 1024 * 1024; // 50MB for images/videos
    }
    
    match /stories/{userId}/thumbnails/{fileName} {
      allow read: if true;
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024; // 5MB for thumbnails
    }
    
    // ===== REELS =====
    match /reels/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 100 * 1024 * 1024; // 100MB for reels videos
    }
    
    match /reels/{userId}/thumbnails/{fileName} {
      allow read: if true;
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024; // 5MB for thumbnails
    }
    
    // ===== CAROUSELS =====
    match /carousels/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 50 * 1024 * 1024; // 50MB for carousel media
    }
    
    match /carousels/{userId}/thumbnails/{fileName} {
      allow read: if true;
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024; // 5MB for thumbnails
    }
    
    // ===== EVENT IMAGES =====
    match /events/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024 // 10MB
                   && request.resource.contentType.matches('image/.*');
    }

    // ===== CITY LOGOS =====
    match /city-logos/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 2 * 1024 * 1024 // 2MB
                   && request.resource.contentType.matches('image/.*');
    }

    match /city-logos/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // ===== BRAND LOGOS =====
    // The authenticated admin uploads the logo before the server creates the
    // brand account. Scoping files to the uploader prevents cross-account
    // replacement while keeping the resulting logo publicly readable.
    match /brand-logos/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ===== BREAKING NEWS MEDIA =====
    match /breaking_news/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 50 * 1024 * 1024; // 50MB images/videos
    }

    match /breaking_news/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // ===== USER AVATARS =====
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024 // 5MB
                   && request.resource.contentType.matches('image/.*');
    }

    // Default: deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
