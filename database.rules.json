{
  "rules": {
    // Public read for published content
    "posts": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'editor')",
      ".indexOn": ["status"],
      "$postId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'editor') && (!root.child('users').child(auth.uid).child('status').exists() || root.child('users').child(auth.uid).child('status').val() === 'active')",
        "analytics": {
          ".read": true,
          ".write": "auth != null"
        }
      }
    },
    
    "stories": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'editor')",
      "$storyId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'editor') && (!root.child('users').child(auth.uid).child('status').exists() || root.child('users').child(auth.uid).child('status').val() === 'active')",
        "analytics": {
          ".read": true,
          ".write": "auth != null"
        }
      }
    },
    
    "reels": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'editor')",
      ".indexOn": ["status"],
      "$reelId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'editor') && (!root.child('users').child(auth.uid).child('status').exists() || root.child('users').child(auth.uid).child('status').val() === 'active')",
        "analytics": {
          ".read": true,
          ".write": "auth != null"
        }
      }
    },
    
    "carousels": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'editor')",
      ".indexOn": ["status"],
      "$carouselId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'editor') && (!root.child('users').child(auth.uid).child('status').exists() || root.child('users').child(auth.uid).child('status').val() === 'active')",
        "analytics": {
          ".read": true,
          ".write": "auth != null"
        }
      }
    },
    
    // Comments are public to read; authors own their text and every user owns
    // only their own like marker. Moderators/admins can manage all comments.
    "comments": {
      ".read": true,
      "$postId": {
        "$commentId": {
          ".write": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'moderator') || ((!root.child('users').child(auth.uid).child('status').exists() || root.child('users').child(auth.uid).child('status').val() === 'active') && ((!data.exists() && newData.child('authorId').val() === auth.uid) || (data.exists() && data.child('authorId').val() === auth.uid && (!newData.exists() || newData.child('authorId').val() === auth.uid)))))",
          "likedBy": {
            "$uid": { ".write": "auth != null && auth.uid === $uid" }
          },
          "likes": { ".write": "auth != null" },
          "replies": {
            "$replyId": {
              ".write": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'moderator') || ((!data.exists() && newData.child('authorId').val() === auth.uid) || (data.exists() && data.child('authorId').val() === auth.uid && (!newData.exists() || newData.child('authorId').val() === auth.uid))))",
              "likedBy": { "$uid": { ".write": "auth != null && auth.uid === $uid" } },
              "likes": { ".write": "auth != null" },
              "replies": {
                "$nestedReplyId": {
                  ".write": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'moderator') || ((!data.exists() && newData.child('authorId').val() === auth.uid) || (data.exists() && data.child('authorId').val() === auth.uid && (!newData.exists() || newData.child('authorId').val() === auth.uid))))",
                  "likedBy": { "$uid": { ".write": "auth != null && auth.uid === $uid" } },
                  "likes": { ".write": "auth != null" }
                }
              }
            }
          }
        }
      }
    },
    
    // Users - users can read their own data and admins can read all
    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "role": {
          ".validate": "root.child('users').child(auth.uid).child('role').val() === 'admin' || (data.exists() && newData.val() === data.val()) || (!data.exists() && newData.val() === 'user')"
        },
        "brandId": {
          ".validate": "root.child('users').child(auth.uid).child('role').val() === 'admin' || (data.exists() && newData.val() === data.val())"
        },
        "status": {
          ".validate": "root.child('users').child(auth.uid).child('role').val() === 'admin' || (data.exists() && newData.val() === data.val()) || (!data.exists() && newData.val() === 'active')"
        }
      }
    },
    
    // Notifications - users can read their own notifications
    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },

    // FCM push tokens are written only by the topic-subscription callables.
    "fcmTokens": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    
    // App settings - public read (frontend may need config), admin write
    "settings": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    // Categories - public read, admin write
    "categories": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    
    // City-scoped content mirrors. Admins and active Editors may keep the
    // same content types they can publish globally in sync here. There is no
    // parent-level write grant, so other city children remain protected.
    "cities": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'editor')",
      "$cityId": {
        "posts": {
          "$postId": {
            ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'editor') && (!root.child('users').child(auth.uid).child('status').exists() || root.child('users').child(auth.uid).child('status').val() === 'active')"
          }
        },
        "stories": {
          "$storyId": {
            ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'editor') && (!root.child('users').child(auth.uid).child('status').exists() || root.child('users').child(auth.uid).child('status').val() === 'active')"
          }
        },
        "reels": {
          "$reelId": {
            ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'editor') && (!root.child('users').child(auth.uid).child('status').exists() || root.child('users').child(auth.uid).child('status').val() === 'active')"
          }
        },
        "carousels": {
          "$carouselId": {
            ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'editor') && (!root.child('users').child(auth.uid).child('status').exists() || root.child('users').child(auth.uid).child('status').val() === 'active')"
          }
        }
      }
    },
    
    // Cities Config - public read, admin write
    "cities-config": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "publicPosts": { ".read": true, ".write": false, ".indexOn": ["timestamp", "publishedAt"] },
    "publicStories": { ".read": true, ".write": false, ".indexOn": ["timestamp", "publishedAt"] },
    "publicReels": { ".read": true, ".write": false, ".indexOn": ["timestamp", "publishedAt"] },
    "publicCarousels": { ".read": true, ".write": false, ".indexOn": ["timestamp", "publishedAt"] },
    
    // Private event operations and registration details are admin-only.
    // Guests use the privacy-filtered publicEvents projection.
    "events": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "publicEvents": {
      ".read": true,
      ".write": false,
      ".indexOn": ["status", "startDate"]
    },
    
    // Poll definitions are public; votes are accepted only by the callable.
    "polls": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "pollVotes": {
      "$pollId": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        }
      }
    },
    
    // Breaking News - public read, admin write
    "breakingNews": {
      ".read": true,
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'editor')"
    },
    
    // Live Updates - public read, admin write
    "liveUpdates": {
      ".read": true,
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'editor')"
    },

    // Trending Stories (auto-generated) - public read, admin write
    "trendingStories": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    // AI Picks (auto-generated) - public read, admin write
    "aiPicks": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    // Post analytics - public read, authenticated write
    "postAnalytics": {
      ".read": true,
      ".write": "auth != null"
    },

    // User interactions (for recommendations) - authenticated write
    "userInteractions": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$interactionId": {
        ".write": "auth != null && !data.exists() && newData.child('userId').val() === auth.uid"
      }
    },

    // Content reports - authenticated users can create one immutable report
    // per post; only admins can read reports or take moderation actions.
    "contentReports": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'moderator')",
      "$contentId": {
        "$reporterId": {
          ".write": "auth != null && ((!data.exists() && auth.uid === $reporterId && newData.child('reporterId').val() === auth.uid && newData.child('contentId').val() === $contentId && newData.child('status').val() === 'pending') || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'moderator')",
          ".validate": "!newData.exists() || (newData.hasChildren(['contentId', 'contentType', 'reason', 'status', 'reporterId', 'createdAt', 'updatedAt']) && newData.child('contentId').val() === $contentId && newData.child('contentType').val() === 'post' && newData.child('reason').isString() && newData.child('reporterId').val() === $reporterId && newData.child('status').isString() && newData.child('createdAt').isString() && newData.child('updatedAt').isString())"
        }
      }
    },
    
    // News Roundups - public read, admin write
    "news-roundups": {
      ".read": true,
      "$roundupId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },

    // Leads - public submissions are written by Cloud Functions; admins manage them
    "leads": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    // Lead message templates - admin only
    "leadMessageTemplates": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    // Third-party integrations - admin only
    "integrations": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    // Lead notification logs - admin only, indexed for lead-specific lookups
    "leadNotificationLogs": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".indexOn": ["leadId"]
    },

    // Lead WhatsApp logs - admin only, indexed for lead-specific lookups
    "leadWhatsAppLogs": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".indexOn": ["leadId"]
    },
    
    // Analytics - admin only
    "analytics": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null"
    },
    
    // SOS - Blood Requests
    "bloodRequests": {
      ".read": true,
      ".write": "auth != null"
    },
    
    // Blood SOS - Emergency blood requests by city
    "blood-sos": {
      ".read": true,
      "$city": {
        "$requestId": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (!data.exists() && newData.child('createdBy').val() === auth.uid) || (data.exists() && data.child('createdBy').val() === auth.uid && (!newData.exists() || newData.child('createdBy').val() === auth.uid)))"
        }
      }
    },
    
    // Bookmarks - users can access their own bookmarks
    "bookmarks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "eventBookmarks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "notificationPreferences": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "couponBrands": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "brandsPublic": {
      ".read": true,
      ".write": false
    },

    "brandSlugs": {
      ".read": true,
      ".write": false
    },

    "couponCategories": {
      ".read": true,
      ".write": false
    },

    "brandAccounts": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$brandId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (root.child('users').child(auth.uid).child('role').val() === 'brand' && root.child('users').child(auth.uid).child('brandId').val() === $brandId && data.child('authUid').val() === auth.uid))",
        ".write": false
      }
    },

    "offers": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (root.child('users').child(auth.uid).child('role').val() === 'brand' && query.orderByChild === 'brandId' && query.equalTo === root.child('users').child(auth.uid).child('brandId').val()))",
      ".write": false,
      ".indexOn": ["brandId", "categoryId", "status", "endsAt"]
    },

    "publicOffers": {
      ".read": true,
      ".write": false,
      ".indexOn": ["brandId", "categoryId", "endsAt"]
    },

    "brandRedemptionFeed": {
      "$brandId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (root.child('users').child(auth.uid).child('role').val() === 'brand' && root.child('users').child(auth.uid).child('brandId').val() === $brandId && root.child('brandAccounts').child($brandId).child('authUid').val() === auth.uid))",
        ".write": false,
        ".indexOn": ["offerId", "redeemedAt"]
      }
    },

    "offerClaimCountsByUser": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "couponRedemptions": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": false,
      ".indexOn": ["code", "brandId", "userId", "status"]
    },

    "couponClaimsByUser": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "userCoupons": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "couponAudit": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": false
    },

    "eventPayments": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": false
    },

    "registrationSecurity": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "disposableDomains": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      },
      "flaggedUsers": {
        "$uid": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
        }
      },
      "audit": { ".write": false },
      "rateLimits": { ".write": false }
    },
    
    // Likes - users can like content
    "likes": {
      ".read": true,
      "$postId": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    
    // Views/Analytics tracking
    "views": {
      ".read": true,
      ".write": false
    }
  }
}
